/* ==========================================================
   TALENTSPHERE AI - MODERN GLASS UI
========================================================== */

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

html,
body,
.stApp{

    background:#f3f7fc;

}

/* Hide Streamlit Branding */

#MainMenu{
    visibility:hidden;
}

footer{
    visibility:hidden;
}

header{
    visibility:hidden;
}

/* ==========================================================
SIDEBAR
========================================================== */

section[data-testid="stSidebar"]{

    background:#111827;
    border-right:1px solid #1f2937;

}

section[data-testid="stSidebar"] *{

    color:white;

}

.user-card{

    display:flex;
    align-items:center;
    gap:15px;

    padding:15px;

    border-radius:18px;

    background:#1f2937;

    margin-bottom:20px;

}

.avatar{

    width:60px;
    height:60px;

    border-radius:50%;

    background:linear-gradient(135deg,#4f46e5,#2563eb);

    display:flex;
    justify-content:center;
    align-items:center;

    font-size:26px;
    font-weight:700;

    color:white;

}

.user-details h4{

    margin:0;
    color:white;

}

.user-details p{

    margin-top:4px;
    font-size:13px;
    color:#cbd5e1;

}

/* ==========================================================
LOGIN PAGE
========================================================== */

.login-left{

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    color:white;

    border-radius:30px;

    padding:70px;

    min-height:720px;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:flex-start;

    box-shadow:0 20px 50px rgba(37,99,235,.25);

}

.login-left h1{

    font-size:54px;

    font-weight:800;

    margin-bottom:15px;

}

.login-left h3{

    font-size:26px;

    margin-bottom:30px;

}

.login-left p{

    font-size:18px;

    line-height:2;

}

.login-card{

    background:white;

    border-radius:30px;

    padding:45px;

    box-shadow:0 20px 45px rgba(0,0,0,.10);

}

/* ==========================================================
BUTTONS
========================================================== */

.stButton>button{

    width:100%;

    border:none;

    border-radius:12px;

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    color:white;

    font-weight:600;

    transition:.25s;

}

.stButton>button:hover{

    transform:translateY(-3px);

    box-shadow:0 15px 30px rgba(79,70,229,.35);

}

/* ==========================================================
INPUTS
========================================================== */

input{

    border-radius:12px !important;

}

div[data-baseweb="select"]{

    border-radius:12px;

}

/* ==========================================================
DASHBOARD HERO
========================================================== */

.dashboard-banner{

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    border-radius:25px;

    padding:45px;

    color:white;

    margin-bottom:30px;

    box-shadow:0 15px 40px rgba(79,70,229,.25);

}

.dashboard-banner h1{

    font-size:40px;

    font-weight:700;

    margin-bottom:10px;

}

.dashboard-banner p{

    font-size:18px;

    opacity:.95;

}

/* ==========================================================
METRIC CARDS
========================================================== */

.metric-card{

    background:white;

    border-radius:22px;

    padding:28px;

    text-align:center;

    box-shadow:0 10px 30px rgba(0,0,0,.08);

    transition:.3s;

}

.metric-card:hover{

    transform:translateY(-8px);

}

.metric-value{

    font-size:36px;

    font-weight:700;

    color:#2563eb;

}

.metric-label{

    margin-top:10px;

    color:#64748b;

}

/* ==========================================================
QUICK ACTIONS
========================================================== */

.quick-card{

    background:white;

    border-radius:22px;

    padding:30px;

    text-align:center;

    min-height:240px;

    box-shadow:0 12px 30px rgba(0,0,0,.08);

    transition:.3s;

}

.quick-card:hover{

    transform:translateY(-8px);

}

.quick-icon{

    font-size:55px;

    margin-bottom:15px;

}

.quick-card h3{

    margin-bottom:15px;

    color:#111827;

}

.quick-card p{

    color:#64748b;

    line-height:1.7;

}

/* ==========================================================
INFO CARD
========================================================== */

.info-card{

    background:white;

    border-radius:20px;

    padding:30px;

    text-align:center;

    box-shadow:0 10px 25px rgba(0,0,0,.08);

}

.card-icon{

    font-size:50px;

    margin-bottom:15px;

}

/* ==========================================================
RESULT CARD
========================================================== */

.result-card{

    background:white;

    border-radius:18px;

    padding:25px;

    margin-bottom:20px;

    box-shadow:0 8px 20px rgba(0,0,0,.08);

}

.result-top{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:18px;

}

.score-badge{

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    color:white;

    padding:6px 18px;

    border-radius:30px;

    font-size:14px;

    font-weight:700;

}

.result-text{

    color:#374151;

    line-height:1.7;

}

/* ==========================================================
EMPTY STATE
========================================================== */

.empty-card{

    background:white;

    border-radius:22px;

    text-align:center;

    padding:60px;

    box-shadow:0 10px 30px rgba(0,0,0,.08);

}

.empty-icon{

    font-size:70px;

    margin-bottom:20px;

}

/* ==========================================================
FOOTER
========================================================== */

hr{

    border:none;

    height:1px;

    background:#d1d5db;

    margin-top:40px;

    margin-bottom:20px;

}

small{

    color:#64748b;

}
/* ==========================================================
   ADDED — these classes were referenced by your Python code
   but were missing from the stylesheet, so they rendered
   with zero styling.
========================================================== */

/* Used by section_header() in src/ui.py — the big banner at the
   top of the Ingest and Search pages. */
.hero-section{
    background:linear-gradient(135deg,#2563eb,#4f46e5);
    border-radius:25px;
    padding:40px 45px;
    color:white;
    margin-bottom:26px;
    box-shadow:0 15px 40px rgba(79,70,229,.25);
}
.hero-section h1{
    font-size:34px;
    font-weight:700;
    margin-bottom:8px;
}
.hero-section p{
    font-size:16px;
    opacity:.95;
    margin:0;
}

/* Used inside the dashboard's Upload/Search containers in app.py */
.feature-card h2{
    margin-bottom:10px;
    color:#111827;
    font-size:22px;
    text-align:center;
}
.feature-card p{
    color:#64748b;
    line-height:1.6;
    text-align:center;
}

/* Used for each indexed document row on the dashboard */
.document-card{
    background:white;
    padding:16px 20px;
    border-radius:14px;
    margin-bottom:10px;
    border-left:6px solid #2563eb;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
    font-weight:600;
    color:#1e293b;
}

/* Used inside the dashboard's Profile container in app.py */
.profile-card{
    text-align:center;
    margin-bottom:6px;
}
.profile-card h2{
    color:#111827;
    margin-bottom:4px;
}

/* ==========================================================
   Native Streamlit bordered containers — st.container(border=True)
   This is what actually boxes real widgets (buttons, forms,
   inputs) together, since a hand-written <div> can't wrap them.
   Used for: the login card, the Upload/Search feature cards, and
   the Profile card.
========================================================== */
div[data-testid="stVerticalBlockBorderWrapper"]{
    background:white;
    border-radius:22px !important;
    border:1px solid rgba(0,0,0,0.06) !important;
    box-shadow:0 12px 34px rgba(37,99,235,.10);
    padding:10px 8px;
}